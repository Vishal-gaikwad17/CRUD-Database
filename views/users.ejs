<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Users</title>
</head>
<body style="justify-content: center;">
  
   <ul>
        <% users.forEach(user => { %>
      <li>
       <b> <%= user.Name %></b>
        <br>
        Age: <%= user.Age %>
        <br>
        Phone: <%= user.phone %>
      </li>
      <hr>
    <% }) %>

</ul>
<button style="font-size: medium; font-weight: 700; margin-left: 550px;" ><a href="/addUser">Add User</a></button>

</body>
</html>
